# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fase 0.5 — backups financeiros gerados localmente (dados reais + PINs em texto
# simples). Nunca deve ir para o git nem para um remoto partilhado sem cuidado extra.
/backup/

# Supabase CLI — estado local da ferramenta (ex. versão descarregada), não do projeto.
/supabase/.temp/
